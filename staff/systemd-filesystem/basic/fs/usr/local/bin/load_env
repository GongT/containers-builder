#!/usr/bin/bash

# 大部分时候直接用 eval "$(load_env)" 即可加载环境变量
# 为了支持复制输出且不污染子进程，没有直接使用 set -a / cat 等功能

VERB="export"
if [[ ${1-} == "--local" ]]; then
	VERB=""
	shift
fi

WHAT=${1:-all}

declare -a CONTENT=()
case "${WHAT}" in
system)
	mapfile -t CONTENT </etc/environment
	;;
user)
	mapfile -t CONTENT </run/.userenvironments
	;;
*)
	mapfile -t CONTENT </run/.userenvironments
	mapfile -O "${#CONTENT[@]}" -t CONTENT </etc/environment
	;;
esac

LINE=''
for LINE in "${CONTENT[@]}"; do
	if [[ -z ${LINE} || ${LINE} == '#'* ]]; then
		continue
	fi

	NAME="${LINE%%=*}"
	VALUE="${LINE#*=}"

	printf '%s %s="%q"\n' "${VERB}" "${NAME}" "${VALUE}"
done
