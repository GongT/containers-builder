#!/usr/bin/bash

if [[ -z ${NOTIFY_SOCKET-} ]]; then
	if [[ -z ${__NOTIFY_SOCKET__-} ]]; then
		eval "$(load_env user)"
	fi
	if [[ -z ${__NOTIFY_SOCKET__-} ]]; then
		echo "无法发送通知: 缺少 __NOTIFY_SOCKET__ 环境变量" >&2
		exit 1
	fi
	export NOTIFY_SOCKET="${__NOTIFY_SOCKET__}"
else
	export NOTIFY_SOCKET
fi

systemd-notify "$@"
