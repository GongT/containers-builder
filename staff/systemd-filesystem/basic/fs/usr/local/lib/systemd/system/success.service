# 此服务在systemd启动前（包括构建）添加了一些依赖服务，并且multi-user等target强依赖于它
# 以实现这些target间接依赖那些服务的功能
# 所有那些服务都启动就会发送成功通知，不需要非核心服务全部成功

[Unit]
Description=向容器外发送容器启动完成通知
RefuseManualStart=yes
RefuseManualStop=yes
After=notify-stop.service
Requires=notify-stop.service
Before=default.target

[Install]
RequiredBy=default.target
# WantedBy=graphical.target multi-user.target

[Service]
Type=oneshot
RemainAfterExit=no
ExecStart=/usr/bin/echo "向容器外发送启动完成通知"
ExecStart=/usr/local/bin/systemd-host-notify --ready --status="正常运行中"
StandardOutput=journal+console
StandardError=journal+console
