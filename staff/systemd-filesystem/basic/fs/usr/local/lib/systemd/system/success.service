[Unit]
Description=当default.target成功时，向容器外发送容器启动完成通知
ConditionEnvironment=
RefuseManualStart=yes
RefuseManualStop=yes
Wants=notify-stop.service
Before=notify-stop.service
After=default.target
Requires=default.target
FailureAction=exit
FailureActionExitStatus=233

[Install]
WantedBy=default.target

[Service]
Type=oneshot
RemainAfterExit=no
ExecStart=/usr/bin/echo "向容器外发送启动完成通知"
ExecStart=/usr/local/bin/systemd-host-notify --ready --status="正常运行中"
StandardOutput=journal+console
StandardError=journal+console
