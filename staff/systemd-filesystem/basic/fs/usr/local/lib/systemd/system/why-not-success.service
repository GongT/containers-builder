[Unit]
Description=容器退出前显示 success.service 启动失败的原因
DefaultDependencies=no
Requires=local-fs.target
Before=basic.target
RefuseManualStart=yes
CollectMode=inactive-or-failed

[Install]
WantedBy=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStop=/usr/bin/systemctl list-dependencies success.service --no-pager --legend=no
StandardOutput=journal+console
StandardError=journal+console
Restart=no
